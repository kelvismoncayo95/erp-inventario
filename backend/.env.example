# ============================================
# .env.example — plantilla pública
# Copia este archivo a .env y ajusta los valores.
# ============================================

# ---------- Base de datos ----------
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/erp_inventario

# ---------- Seguridad JWT ----------
# Genera una nueva con: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- Reglas de negocio ----------
IVA_PORCENTAJE=22
MINUTOS_ANULACION_VENDEDOR=5
STOCK_MINIMO_REACTIVAR=10
