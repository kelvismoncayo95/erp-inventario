<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>ERP Inventario</title>
<link rel="stylesheet" href="estilos.css">
</head>
<body>

<!-- ========== VISTA LOGIN ========== -->
<div id="vista-login" class="vista-login">
  <div class="login-card">
    <h1>📦 ERP Inventario</h1>
    <p class="sub">Inicia sesión para continuar</p>
    <form id="login-form">
      <label>Email</label>
      <input id="login-email" type="email" placeholder="admin@erp.com" required>
      <label>Contraseña</label>
      <input id="login-password" type="password" placeholder="••••••••" required>
      <button type="submit" class="btn-primary">Iniciar Sesión</button>
      <p id="login-error" class="err"></p>
    </form>
  </div>
</div>

<!-- ========== VISTA APP ========== -->
<div id="vista-app" class="vista-app" style="display:none">

  <header class="topbar">
    <div>
      <h1>📦 ERP Inventario</h1>
      <span class="user">Hola, <strong id="usuario-nombre">—</strong></span>
    </div>
    <button class="btn-logout">Salir</button>
  </header>

  <nav class="tabs">
    <button class="tab-btn activo" data-tab="productos">Productos</button>
    <button class="tab-btn" data-tab="nuevo">Nuevo</button>
    <button class="tab-btn" data-tab="ventas">Ventas</button>
    <button class="tab-btn" data-tab="reportes">Reportes</button>
    <button class="tab-btn" data-tab="categorias">Categorías</button>
  </nav>

  <main>

    <!-- TAB PRODUCTOS -->
    <section id="tab-productos" class="tab-content">
      <h2>Lista de Productos</h2>

      <div class="filtros">
        <input id="filtro-texto" type="text" placeholder="🔍 Escribe para buscar...">
        <div class="chips">
          <button class="chip activo" data-campo="todos">Todos</button>
          <button class="chip" data-campo="nombre">Nombre</button>
          <button class="chip" data-campo="sku">SKU</button>
          <button class="chip" data-campo="descripcion">Descripción</button>
          <button class="chip" data-campo="proveedor">Proveedor</button>
          <button class="chip" data-campo="categoria">Categoría</button>
        </div>
        <input type="hidden" id="filtro-campo" value="todos">
        <div class="estados">
          <label><input type="radio" name="filtro-estado" value="activos" checked> ✅ Activos</label>
          <label><input type="radio" name="filtro-estado" value="todos"> 📋 Todos</label>
          <label><input type="radio" name="filtro-estado" value="eliminados"> 🗑️ Eliminados</label>
        </div>
      </div>

      <div id="lista-productos" class="grid-productos"></div>
    </section>

    <!-- TAB NUEVO PRODUCTO -->
    <section id="tab-nuevo" class="tab-content" style="display:none">
      <h2>Nuevo Producto</h2>
      <form id="form-nuevo-producto" class="form-grid">
        <label>Nombre <input id="np-nombre" required></label>
        <label>SKU <input id="np-sku" required></label>
        <label>Descripción <input id="np-descripcion"></label>
        <label>Precio costo <input id="np-costo" type="number" step="0.01" required></label>
        <label>Precio venta <input id="np-venta" type="number" step="0.01" required></label>
        <label>Stock actual <input id="np-stock" type="number" value="0"></label>
        <label>Stock mínimo <input id="np-min" type="number" value="5"></label>
        <label>Stock máximo <input id="np-max" type="number" value="100"></label>
        <label>Categoría <select id="np-categoria"><option value="">Sin categoría</option></select></label>
        <label>Proveedor <select id="np-proveedor"><option value="">Sin proveedor</option></select></label>
        <div class="full">
          <button type="submit" class="btn-primary">Crear Producto</button>
          <p id="np-msg"></p>
        </div>
      </form>
    </section>

    <!-- TAB VENTAS -->
    <section id="tab-ventas" class="tab-content" style="display:none">
      <h2>Nueva Venta</h2>
      <div class="venta-grid">
        <div class="venta-form">
          <label>Producto <select id="venta-producto"><option value="">Seleccionar...</option></select></label>
          <label>Cantidad <input id="venta-cantidad" type="number" value="1" min="1"></label>
          <button id="btn-agregar-carrito" class="btn-primary">➕ Agregar al carrito</button>
        </div>
        <div class="carrito">
          <h3>Carrito</h3>
          <div id="carrito-lista"><p class="vacio">Carrito vacío</p></div>
          <div class="totales">
            <p>Subtotal: <span id="carrito-subtotal">0</span></p>
            <p>IVA (22%): <span id="carrito-iva">0</span></p>
            <p><strong>Total: <span id="carrito-total">0</span></strong></p>
          </div>
          <label>Cliente <input id="venta-cliente" placeholder="Opcional"></label>
          <label>Teléfono <input id="venta-telefono" placeholder="Opcional"></label>
          <button id="btn-confirmar-venta" class="btn-primary">✅ Confirmar Venta</button>
        </div>
      </div>

      <h2>Historial de Ventas</h2>
      <div id="lista-ventas" class="grid-ventas"></div>
    </section>

    <!-- TAB REPORTES -->
    <section id="tab-reportes" class="tab-content" style="display:none">
      <h2>Resumen</h2>
      <div id="rep-resumen" class="kpis"></div>

      <h2>Productos más vendidos</h2>
      <div id="rep-mas-vendidos" class="reportes-lista"></div>

      <h2>Ganancias por período</h2>
      <div id="rep-ganancias" class="reportes-lista"></div>

      <h2>Stock bajo</h2>
      <div id="rep-stock-bajo" class="reportes-lista"></div>
    </section>

    <!-- TAB CATEGORÍAS -->
    <section id="tab-categorias" class="tab-content" style="display:none">
      <h2>Nueva Categoría</h2>
      <form id="form-categoria" class="form-inline">
        <input id="cat-nombre" placeholder="Nombre" required>
        <input id="cat-descripcion" placeholder="Descripción">
        <button type="submit" class="btn-primary">Crear</button>
        <p id="cat-msg"></p>
      </form>
      <h2>Listado</h2>
      <div id="lista-categorias" class="grid-categorias"></div>
    </section>

  </main>
</div>

<script src="app.js"></script>
</body>
</html>
