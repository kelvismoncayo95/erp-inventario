const API_URL = 'http://localhost:8000';
let todosLosProductos = [];
let productosVenta = {};

async function apiFetch(ep, opts = {}) {
    const token = localStorage.getItem('token');
    const headers = { 'Content-Type': 'application/json', ...(opts.headers || {}) };
    if (token) headers['Authorization'] = 'Bearer ' + token;
    const r = await fetch(API_URL + ep, { ...opts, headers });
    if (r.status === 401) {
        localStorage.removeItem('token');
        localStorage.removeItem('usuario');
        document.getElementById('vista-app').style.display = 'none';
        document.getElementById('vista-login').style.display = 'block';
        throw new Error('Sesión expirada');
    }
    return r;
}

window.addEventListener('load', () => {
    const t = localStorage.getItem('token');
    const u = localStorage.getItem('usuario');
    if (t && u) {
        mostrarApp(JSON.parse(u));
    } else {
        document.getElementById('vista-login').style.display = 'block';
    }
});

function mostrarApp(u) {
    document.getElementById('vista-login').style.display = 'none';
    document.getElementById('vista-app').style.display = 'block';
    document.getElementById('user-nombre').textContent = u.nombre;
    document.getElementById('user-email').textContent = u.email;
    document.getElementById('user-rol').textContent = u.rol.toUpperCase();
    cargarProductos();
}

async function hacerLogin(e) {
    e.preventDefault();
    const b = document.getElementById('btn-login');
    b.disabled = true;
    b.textContent = 'Entrando...';
    const em = document.getElementById('login-email').value;
    const pw = document.getElementById('login-password').value;
    try {
        const fd = new URLSearchParams();
        fd.append('username', em);
        fd.append('password', pw);
        const r = await fetch(API_URL + '/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: fd
        });
        const res = await r.json();
        if (!r.ok) {
            mostrarMensaje('mensaje-login', '❌ ' + (res.detail || 'Error'), 'error');
            return;
        }
        localStorage.setItem('token', res.access_token);
        const ru = await fetch(API_URL + '/auth/me', {
            headers: { 'Authorization': 'Bearer ' + res.access_token }
        });
        const user = await ru.json();
        localStorage.setItem('usuario', JSON.stringify(user));
        mostrarApp(user);
    } catch (err) {
        mostrarMensaje('mensaje-login', '❌ ' + err.message, 'error');
    } finally {
        b.disabled = false;
        b.textContent = 'Iniciar Sesión';
    }
}

function cerrarSesion() {
    localStorage.removeItem('token');
    localStorage.removeItem('usuario');
    location.reload();
}

function cambiarTab(t, el) {
    document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
    document.querySelectorAll('.contenido-tab').forEach(x => x.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('tab-' + t).classList.add('active');
    if (t === 'productos') cargarProductos();
    else if (t === 'ventas') { cargarProductosVenta(); cargarHistorialVentas(); }
    else if (t === 'reportes') cargarReportes();
    else if (t === 'categorias') cargarCategorias();
}

function mostrarMensaje(id, txt, tipo = 'exito') {
    const m = document.getElementById(id);
    if (!m) return;
    m.textContent = txt;
    m.className = 'mensaje ' + tipo;
    setTimeout(() => { m.className = 'mensaje'; }, 5000);
}

async function cargarProductos() {
    const l = document.getElementById('lista-productos');
    l.innerHTML = '<div class="loading">Cargando...</div>';
    try {
        const r = await apiFetch('/productos/');
        const p = await r.json();
        todosLosProductos = p;
        if (p.length === 0) {
            l.innerHTML = '<div class="loading">Sin productos</div>';
            return;
        }
        l.innerHTML = p.map(x =>
            '<div class="producto"><div class="producto-info"><h3>' + x.nombre +
            '</h3><p>SKU: ' + x.sku + '</p></div><div class="producto-precio">' +
            '<div class="precio">$' + x.precio_venta + '</div>' +
            '<div class="stock' + (x.stock_actual <= x.stock_minimo ? ' stock-bajo' : '') +
            '">Stock: ' + x.stock_actual + '</div></div></div>'
        ).join('');
    } catch (e) {
        l.innerHTML = '<div class="mensaje error">❌ ' + e.message + '</div>';
    }
}

function filtrarProductos() {
    const b = document.getElementById('buscar-producto').value.toLowerCase();
    const f = todosLosProductos.filter(p =>
        p.nombre.toLowerCase().includes(b) || p.sku.toLowerCase().includes(b)
    );
    const l = document.getElementById('lista-productos');
    l.innerHTML = f.map(x =>
        '<div class="producto"><div class="producto-info"><h3>' + x.nombre +
        '</h3><p>SKU: ' + x.sku + '</p></div><div class="producto-precio">' +
        '<div class="precio">$' + x.precio_venta + '</div>' +
        '<div class="stock">Stock: ' + x.stock_actual + '</div></div></div>'
    ).join('');
}

async function crearProducto(e) {
    e.preventDefault();
    const b = document.getElementById('btn-crear');
    b.disabled = true;
    b.textContent = 'Creando...';
    const d = {
        nombre: document.getElementById('nombre').value,
        sku: document.getElementById('sku').value,
        descripcion: document.getElementById('descripcion').value || null,
        precio_costo: parseFloat(document.getElementById('precio_costo').value),
        precio_venta: parseFloat(document.getElementById('precio_venta').value),
        stock_actual: parseInt(document.getElementById('stock_actual').value) || 0,
        categoria_id: document.getElementById('categoria_id').value ? parseInt(document.getElementById('categoria_id').value) : null,
        proveedor_id: document.getElementById('proveedor_id').value ? parseInt(document.getElementById('proveedor_id').value) : null
    };
    try {
        const r = await apiFetch('/productos/', { method: 'POST', body: JSON.stringify(d) });
        const res = await r.json();
        if (!r.ok) {
            mostrarMensaje('mensaje-producto', '❌ ' + (res.detail || 'Error'), 'error');
            return;
        }
        mostrarMensaje('mensaje-producto', '✅ Producto creado', 'exito');
        document.getElementById('form-producto').reset();
    } catch (err) {
        mostrarMensaje('mensaje-producto', '❌ ' + err.message, 'error');
    } finally {
        b.disabled = false;
        b.textContent = 'Crear Producto';
    }
}

async function cargarProductosVenta() {
    const c = document.getElementById('productos-venta');
    c.innerHTML = '<div class="loading">Cargando...</div>';
    try {
        const r = await apiFetch('/productos/');
        const p = await r.json();
        productosVenta = {};
        c.innerHTML = p.map(x =>
            '<div class="producto"><div class="producto-info"><h3>' + x.nombre +
            '</h3><p>SKU: ' + x.sku + ' | Stock: ' + x.stock_actual + '</p></div>' +
            '<div class="producto-precio"><div class="precio">$' + x.precio_venta + '</div>' +
            '<input type="number" min="0" max="' + x.stock_actual + '" value="0" ' +
            'style="width:80px;padding:6px;margin-top:4px" ' +
            'onchange="actualizarCantidad(' + x.id + ',this.value)"></div></div>'
        ).join('');
    } catch (e) {
        c.innerHTML = '<div class="mensaje error">❌ ' + e.message + '</div>';
    }
}

function actualizarCantidad(id, c) {
    c = parseInt(c) || 0;
    if (c > 0) productosVenta[id] = { cantidad: c };
    else delete productosVenta[id];
}

async function confirmarVenta() {
    const items = Object.entries(productosVenta).map(([id, d]) => ({
        producto_id: parseInt(id),
        cantidad: d.cantidad
    }));
    if (items.length === 0) {
        mostrarMensaje('mensaje-venta', '❌ Selecciona al menos un producto', 'error');
        return;
    }
    const d = {
        cliente_nombre: document.getElementById('venta-cliente').value || null,
        cliente_telefono: document.getElementById('venta-telefono').value || null,
        items
    };
    try {
        const r = await apiFetch('/ventas/', { method: 'POST', body: JSON.stringify(d) });
        const res = await r.json();
        if (!r.ok) {
            mostrarMensaje('mensaje-venta', '❌ ' + (res.detail || 'Error'), 'error');
            return;
        }
        mostrarMensaje('mensaje-venta', '✅ Venta #' + res.id + ' - $' + res.total, 'exito');
        document.getElementById('venta-cliente').value = '';
        document.getElementById('venta-telefono').value = '';
        cargarProductosVenta();
        cargarHistorialVentas();
    } catch (e) {
        mostrarMensaje('mensaje-venta', '❌ ' + e.message, 'error');
    }
}

async function cargarHistorialVentas() {
    const c = document.getElementById('historial-ventas');
    c.innerHTML = '<div class="loading">Cargando...</div>';
    try {
        const r = await apiFetch('/ventas/');
        const v = await r.json();
        if (v.length === 0) {
            c.innerHTML = '<div class="loading">Sin ventas</div>';
            return;
        }
        c.innerHTML = v.map(x =>
            '<div class="producto"><div class="producto-info"><h3>' +
            (x.numero_factura || '#' + x.id) + '</h3><p>' +
            new Date(x.fecha).toLocaleDateString() + '</p></div>' +
            '<div class="producto-precio"><div class="precio">$' + x.total + '</div>' +
            '<div class="stock">' + x.estado + '</div></div></div>'
        ).join('');
    } catch (e) {
        c.innerHTML = '<div class="mensaje error">❌ ' + e.message + '</div>';
    }
}

async function cargarReportes() {
    try {
        const r1 = await apiFetch('/reportes/resumen');
        const res = await r1.json();
        document.getElementById('resumen-reportes').innerHTML =
            '<div class="producto"><div class="producto-info"><h3>Productos</h3></div>' +
            '<div class="producto-precio"><div class="precio">' + (res.total_productos || 0) + '</div></div></div>' +
            '<div class="producto"><div class="producto-info"><h3>Ventas</h3></div>' +
            '<div class="producto-precio"><div class="precio">' + (res.total_ventas || 0) + '</div></div></div>' +
            '<div class="producto"><div class="producto-info"><h3>Ingresos</h3></div>' +
            '<div class="producto-precio"><div class="precio">$' + (res.total_ingresos || 0) + '</div></div></div>' +
            '<div class="producto"><div class="producto-info"><h3>Ganancia</h3></div>' +
            '<div class="producto-precio"><div class="precio">$' + (res.ganancia_total || 0) + '</div></div></div>';
        
        const r2 = await apiFetch('/reportes/productos-mas-vendidos');
        const top = await r2.json();
        document.getElementById('top-productos').innerHTML = top.map((p, i) =>
            '<div class="producto"><div class="producto-info"><h3>#' + (i + 1) + ' ' +
            (p.nombre || p.producto_nombre) + '</h3><p>' + (p.total_vendido || p.cantidad) +
            ' vendidos</p></div><div class="producto-precio"><div class="precio">$' +
            (p.ingresos || p.total) + '</div></div></div>'
        ).join('') || '<div class="loading">Sin datos</div>';
        
        const r3 = await apiFetch('/reportes/ganancias');
        const g = await r3.json();
        document.getElementById('ganancias-reportes').innerHTML = g.map(x =>
            '<div class="producto"><div class="producto-info"><h3>' + x.periodo +
            '</h3></div><div class="producto-precio"><div class="precio">$' + x.ingresos +
            '</div><div class="stock">' + x.cantidad_ventas + ' ventas</div></div></div>'
        ).join('') || '<div class="loading">Sin datos</div>';
        
        const r4 = await apiFetch('/reportes/stock-bajo');
        const s = await r4.json();
        if (s.length === 0) {
            document.getElementById('stock-bajo').innerHTML = '<div class="loading">✅ Todo bien</div>';
        } else {
            document.getElementById('stock-bajo').innerHTML = s.map(x =>
                '<div class="producto"><div class="producto-info"><h3>' + x.nombre +
                '</h3><p>SKU: ' + x.sku + '</p></div><div class="producto-precio">' +
                '<div class="precio stock-bajo">' + x.stock_actual + ' / ' + x.stock_minimo +
                '</div></div></div>'
            ).join('');
        }
    } catch (e) {
        console.error(e);
    }
}

async function cargarCategorias() {
    const l = document.getElementById('lista-categorias');
    l.innerHTML = '<div class="loading">Cargando...</div>';
    try {
        const r = await apiFetch('/categorias/');
        const c = await r.json();
        if (c.length === 0) {
            l.innerHTML = '<div class="loading">Sin categorías</div>';
            return;
        }
        l.innerHTML = c.map(x =>
            '<div class="producto"><div class="producto-info"><h3>' + x.nombre +
            '</h3><p>' + (x.descripcion || 'Sin desc') + '</p></div>' +
            '<div class="producto-precio"><button class="btn-eliminar" ' +
            'onclick="eliminarCategoria(' + x.id + ',\'' + x.nombre + '\')">🗑️</button>' +
            '</div></div>'
        ).join('');
    } catch (e) {
        l.innerHTML = '<div class="mensaje error">❌ ' + e.message + '</div>';
    }
}

async function crearCategoria(e) {
    e.preventDefault();
    const b = document.getElementById('btn-crear-categoria');
    b.disabled = true;
    b.textContent = 'Creando...';
    const d = {
        nombre: document.getElementById('cat-nombre').value,
        descripcion: document.getElementById('cat-descripcion').value || null
    };
    try {
        const r = await apiFetch('/categorias/', { method: 'POST', body: JSON.stringify(d) });
        const res = await r.json();
        if (!r.ok) {
            mostrarMensaje('mensaje-categoria', '❌ ' + (res.detail || 'Error'), 'error');
            return;
        }
        mostrarMensaje('mensaje-categoria', '✅ Categoría creada', 'exito');
        document.getElementById('form-categoria').reset();
        cargarCategorias();
    } catch (err) {
        mostrarMensaje('mensaje-categoria', '❌ ' + err.message, 'error');
    } finally {
        b.disabled = false;
        b.textContent = 'Crear Categoría';
    }
}

async function eliminarCategoria(id, nombre) {
    if (!confirm('¿Eliminar categoría ' + nombre + '?')) return;
    try {
        const r = await apiFetch('/categorias/' + id, { method: 'DELETE' });
        if (r.status === 204) {
            mostrarMensaje('mensaje-categoria', '✅ Eliminada', 'exito');
            cargarCategorias();
        } else {
            const res = await r.json();
            mostrarMensaje('mensaje-categoria', '❌ ' + res.detail, 'error');
        }
    } catch (e) {
        mostrarMensaje('mensaje-categoria', '❌ ' + e.message, 'error');
    }
}
