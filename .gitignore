# ============================================
# .gitignore — qué NO subir a GitHub
# ============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# ---------- Variables de entorno (SECRETOS) ----------
.env
.env.local
.env.*.local
*.env

# ---------- Base de datos ----------
*.db
*.sqlite3
*.sql

# ---------- Backups automáticos (los que creamos) ----------
*.backup
*.backup.*
*.bak

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
logs/

# ---------- Node (por si agregas algo) ----------
node_modules/
npm-debug.log*

# ---------- Coverage / tests ----------
.coverage
htmlcov/
.pytest_cache/
.tox/

# ---------- Archivos temporales ----------
tmp/
temp/
*.tmp
